{
  "site": {
    "title": "OpenStatus",
    "description": "Live availability of websites, services and infrastructure.",
    "timezone": "Europe/Amsterdam",
    "historyDays": 30,
    "checkIntervalMs": 60000,
    "slowThresholdMs": 2500,
    "failureThreshold": 2,
    "recoveryThreshold": 2
  },
  "categories": [
    { "id": "websites", "name": "Websites", "description": "Public websites and applications" },
    { "id": "infrastructure", "name": "Infrastructure", "description": "Network services and endpoints" }
  ],
  "monitors": [
    {
      "id": "jxhq",
      "category": "websites",
      "type": "http",
      "name": "jxhq.net",
      "description": "JXHQ website and services",
      "url": "https://jxhq.net/",
      "expectedStatuses": [200],
      "requiredText": "JXHQ",
      "forbiddenText": ["502 Bad Gateway", "Bad Gateway", "upstream unavailable"],
      "timeoutMs": 10000
    },
    {
      "id": "google",
      "category": "websites",
      "type": "http",
      "name": "Google",
      "description": "External reference check",
      "url": "https://www.google.com/",
      "expectedStatuses": [200],
      "requiredText": "Google",
      "forbiddenText": ["502 Bad Gateway", "Bad Gateway"],
      "timeoutMs": 10000
    },
    {
      "id": "cloudflare-dns",
      "category": "infrastructure",
      "type": "dns",
      "name": "Cloudflare DNS",
      "description": "DNS resolution for one.one.one.one",
      "hostname": "one.one.one.one",
      "recordType": "A",
      "expectedValues": ["1.1.1.1", "1.0.0.1"],
      "timeoutMs": 5000
    },
    {
      "id": "example-tcp",
      "category": "infrastructure",
      "type": "tcp",
      "enabled": false,
      "name": "Example TCP service",
      "description": "Checks whether a domain or IP address is reachable on a port",
      "host": "example.com",
      "port": 443,
      "timeoutMs": 5000
    },
    {
      "id": "example-dns",
      "category": "infrastructure",
      "type": "dns",
      "enabled": false,
      "name": "Example DNS check",
      "hostname": "example.com",
      "recordType": "A",
      "expectedValues": [],
      "timeoutMs": 5000
    }
  ]
}

