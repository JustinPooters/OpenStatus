{
  "site": {
    "title": "OpenStatus",
    "description": "Live beschikbaarheid van websites, services en infrastructuur.",
    "timezone": "Europe/Amsterdam",
    "historyDays": 30,
    "checkIntervalMs": 60000,
    "slowThresholdMs": 2500,
    "failureThreshold": 2,
    "recoveryThreshold": 2
  },
  "categories": [
    { "id": "websites", "name": "Websites", "description": "Publieke websites en applicaties" },
    { "id": "infrastructure", "name": "Infrastructuur", "description": "Netwerkdiensten en endpoints" }
  ],
  "monitors": [
    {
      "id": "jxhq",
      "category": "websites",
      "type": "http",
      "name": "jxhq.net",
      "description": "Website en diensten van JXHQ",
      "url": "https://jxhq.net/",
      "expectedStatuses": [200],
      "requiredText": "JXHQ",
      "forbiddenText": ["502 Bad Gateway", "Bad Gateway", "upstream unavailable"],
      "timeoutMs": 10000
    },
    {
      "id": "google",
      "category": "websites",
      "type": "http",
      "name": "Google",
      "description": "Externe referentiecontrole",
      "url": "https://www.google.com/",
      "expectedStatuses": [200],
      "requiredText": "Google",
      "forbiddenText": ["502 Bad Gateway", "Bad Gateway"],
      "timeoutMs": 10000
    },
    {
      "id": "cloudflare-dns",
      "category": "infrastructure",
      "type": "dns",
      "name": "Cloudflare DNS",
      "description": "DNS-resolutie van one.one.one.one",
      "hostname": "one.one.one.one",
      "recordType": "A",
      "expectedValues": ["1.1.1.1", "1.0.0.1"],
      "timeoutMs": 5000
    },
    {
      "id": "example-tcp",
      "category": "infrastructure",
      "type": "tcp",
      "enabled": false,
      "name": "Voorbeeld TCP-service",
      "description": "Controleert of een IP-adres of domein en poort bereikbaar zijn",
      "host": "example.com",
      "port": 443,
      "timeoutMs": 5000
    },
    {
      "id": "example-dns",
      "category": "infrastructure",
      "type": "dns",
      "enabled": false,
      "name": "Voorbeeld DNS-controle",
      "hostname": "example.com",
      "recordType": "A",
      "expectedValues": [],
      "timeoutMs": 5000
    }
  ]
}

