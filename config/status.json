{
  "site": {
    "title": "JXHQ Status",
    "description": "Live availability of JXHQ, client, personal and infrastructure services.",
    "timezone": "Europe/Amsterdam",
    "historyDays": 30,
    "checkIntervalMs": 60000,
    "slowThresholdMs": 2500,
    "failureThreshold": 2,
    "recoveryThreshold": 2
  },
  "categories": [
    { "id": "jxhq", "name": "JXHQ", "description": "Public websites and applications" },
    { "id": "clients", "name": "Client sites", "description": "Websites maintained for clients" },
    { "id": "personal", "name": "Personal", "description": "Personal websites and services" },
    { "id": "databases", "name": "Databases", "description": "Database endpoints and connectivity" },
    { "id": "mail", "name": "Mail", "description": "Outgoing and incoming mail services" },
    { "id": "dns", "name": "DNS resolvers", "description": "Independent public DNS resolution" }
  ],
  "monitors": [
    {
      "id": "jxhq-main",
      "category": "jxhq",
      "type": "http",
      "name": "jxhq.net",
      "description": "Main JXHQ website",
      "url": "https://jxhq.net/",
      "expectedStatuses": [200],
      "forbiddenText": ["502 Bad Gateway", "Bad Gateway", "upstream unavailable"],
      "timeoutMs": 10000
    },
    {
      "id": "jxhq-client",
      "category": "jxhq",
      "type": "http",
      "name": "client.jxhq.net",
      "description": "Client portal",
      "url": "https://client.jxhq.net/",
      "expectedStatuses": [200, 301, 302, 307, 308],
      "forbiddenText": ["502 Bad Gateway", "Bad Gateway", "upstream unavailable"],
      "timeoutMs": 10000
    },
    {
      "id": "jxhq-mail",
      "category": "jxhq",
      "type": "http",
      "name": "jxmail.jxhq.net",
      "description": "JXMail web application",
      "url": "https://jxmail.jxhq.net/",
      "expectedStatuses": [200, 301, 302, 307, 308],
      "forbiddenText": ["502 Bad Gateway", "Bad Gateway", "upstream unavailable"],
      "timeoutMs": 10000
    },
    {
      "id": "herman-witgoed",
      "category": "clients",
      "type": "http",
      "name": "Herman Witgoed",
      "description": "hermanwitgoed.com",
      "url": "https://hermanwitgoed.com/",
      "expectedStatuses": [200, 301, 302, 307, 308],
      "forbiddenText": ["502 Bad Gateway", "Bad Gateway", "upstream unavailable"],
      "timeoutMs": 10000
    },
    {
      "id": "justin-portfolio",
      "category": "personal",
      "type": "http",
      "name": "justinp.dev",
      "description": "Personal portfolio and CV",
      "url": "https://justinp.dev/",
      "expectedStatuses": [200],
      "requiredText": "Justin",
      "forbiddenText": ["502 Bad Gateway", "Bad Gateway", "upstream unavailable"],
      "timeoutMs": 10000
    },
    {
      "id": "mysql",
      "category": "databases",
      "type": "tcp",
      "name": "MySQL",
      "description": "mysql.jxhq.net · TCP 3306",
      "host": "mysql.jxhq.net",
      "port": 3306,
      "timeoutMs": 5000
    },
    {
      "id": "mssql",
      "category": "databases",
      "type": "tcp",
      "name": "Microsoft SQL Server",
      "description": "mssql.jxhq.net · TCP 1433",
      "host": "mssql.jxhq.net",
      "port": 1433,
      "timeoutMs": 5000
    },
    {
      "id": "smtp-submission",
      "category": "mail",
      "type": "tcp",
      "name": "SMTP submission",
      "description": "smtp.pooters.me · TCP 587",
      "host": "smtp.pooters.me",
      "port": 587,
      "timeoutMs": 5000
    },
    {
      "id": "imap-tls",
      "category": "mail",
      "type": "tcp",
      "name": "IMAP over TLS",
      "description": "mail.pooters.me · TCP 993",
      "host": "mail.pooters.me",
      "port": 993,
      "timeoutMs": 5000
    },
    {
      "id": "google-dns-primary",
      "category": "dns",
      "type": "dns",
      "name": "Google Public DNS",
      "description": "Resolver 8.8.8.8",
      "hostname": "one.one.one.one",
      "recordType": "A",
      "servers": ["8.8.8.8"],
      "expectedValues": ["1.1.1.1", "1.0.0.1"],
      "timeoutMs": 5000
    },
    {
      "id": "google-dns-secondary",
      "category": "dns",
      "type": "dns",
      "name": "Google Public DNS secondary",
      "description": "Resolver 8.8.4.4",
      "hostname": "one.one.one.one",
      "recordType": "A",
      "servers": ["8.8.4.4"],
      "expectedValues": ["1.1.1.1", "1.0.0.1"],
      "timeoutMs": 5000
    },
    {
      "id": "cloudflare-dns",
      "category": "dns",
      "type": "dns",
      "name": "Cloudflare DNS",
      "description": "Resolver 1.1.1.1",
      "hostname": "dns.google",
      "recordType": "A",
      "servers": ["1.1.1.1"],
      "expectedValues": ["8.8.8.8", "8.8.4.4"],
      "timeoutMs": 5000
    }
  ]
}

