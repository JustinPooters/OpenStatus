<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= status.site.description %>">
  <meta http-equiv="refresh" content="60">
  <title><%= status.site.title %></title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <link rel="stylesheet" href="/status.css">
</head>
<body class="bg-[#f4f1eb] text-[#111313] antialiased">
  <% const labels={up:'Alles werkt',degraded:'Verminderde prestaties',down:'Er is een storing',unknown:'Status wordt gemeten'}; %>
  <% const serviceLabels={up:'Operationeel',slow:'Vertraagd',down:'Storing',unknown:'Nog geen data'}; %>
  <main class="mx-auto min-h-screen max-w-5xl px-5 py-10 sm:px-8 sm:py-16">
    <header class="mb-12 flex items-start justify-between gap-6">
      <div>
        <a class="mb-5 inline-flex items-center gap-3" href="/">
          <span class="grid size-10 place-items-center bg-[#ff3b3b] font-black text-white">JS</span>
          <span class="font-semibold">status</span>
        </a>
        <h1 class="max-w-2xl text-4xl font-black tracking-[-.04em] sm:text-6xl"><%= labels[status.overall] %><span class="text-[#ff3b3b]">.</span></h1>
        <p class="mt-4 max-w-xl text-[#626767]"><%= status.site.description %></p>
      </div>
      <a href="https://justinp.dev" class="hidden border-b-2 border-[#ff3b3b] pb-1 text-sm font-bold sm:block">justinp.dev</a>
    </header>

    <section class="mb-12 border border-[#d6d2ca] bg-white p-5 sm:p-7" aria-label="Algemene status">
      <div class="flex items-center gap-4">
        <span class="status-dot <%= status.overall %>"></span>
        <div>
          <p class="font-bold"><%= labels[status.overall] %></p>
          <p class="text-sm text-[#6c7171]">Laatst bijgewerkt: <time datetime="<%= status.generatedAt %>"><%= new Date(status.generatedAt).toLocaleString('nl-NL',{timeZone:status.site.timezone}) %></time></p>
        </div>
      </div>
    </section>

    <% status.categories.forEach(category => { %>
      <section class="mb-12">
        <div class="mb-4 flex items-end justify-between border-b border-[#cfcac1] pb-3">
          <div><h2 class="text-xl font-black"><%= category.name %></h2><p class="mt-1 text-sm text-[#747979]"><%= category.description %></p></div>
          <span class="text-xs font-bold uppercase tracking-[.15em] text-[#8a8e8e]"><%= category.services.length %> service<%= category.services.length===1?'':'s' %></span>
        </div>
        <div class="space-y-4">
          <% category.services.forEach(service => { %>
            <article class="border border-[#d6d2ca] bg-white p-5 sm:p-6">
              <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
                <div><h3 class="font-bold"><%= service.name %></h3><p class="mt-1 text-sm text-[#747979]"><%= service.description %></p></div>
                <div class="text-right"><p class="state-label <%= service.state %>"><%= serviceLabels[service.state] %></p><p class="mt-1 text-xs text-[#8a8e8e]"><%= service.uptime===null?'--':service.uptime.toFixed(2)+'%' %> / <%= status.site.historyDays %> dagen</p></div>
              </div>
              <div class="history" style="grid-template-columns:repeat(<%= service.days.length %>,minmax(3px,1fr))" aria-label="Beschikbaarheid over de laatste <%= status.site.historyDays %> dagen">
                <% service.days.forEach(day => { %><span class="day <%= day.state %>" title="<%= day.date %> · <%= day.uptime===null?'geen metingen':day.uptime.toFixed(2)+'% uptime' %>"></span><% }) %>
              </div>
              <div class="mt-2 flex justify-between text-[11px] text-[#969999]"><span><%= status.site.historyDays %> dagen geleden</span><span>vandaag</span></div>
              <% if(service.latest){ %><p class="mt-4 text-xs text-[#747979]">Laatste controle: <%= service.latest.response_ms %> ms<%= service.latest.status_code?' · HTTP '+service.latest.status_code:'' %></p><% } %>
            </article>
          <% }) %>
        </div>
      </section>
    <% }) %>

    <section class="mb-12">
      <div class="mb-4 border-b border-[#cfcac1] pb-3"><h2 class="text-xl font-black">Recente incidenten</h2><p class="mt-1 text-sm text-[#747979]">Onbereikbaarheid door storing in de laatste <%= status.site.historyDays %> dagen.</p></div>
      <% if(!status.incidents.length){ %>
        <div class="border border-dashed border-[#c9c4bb] p-8 text-center text-sm text-[#747979]">Geen incidenten gemeld. Verdacht rustig, precies zoals het hoort.</div>
      <% } else { %>
        <div class="divide-y divide-[#dedad2] border border-[#d6d2ca] bg-white">
          <% status.incidents.forEach(incident => { const service=status.services.find(s=>s.id===incident.monitor_id); %>
            <article class="p-5"><div class="flex flex-wrap justify-between gap-2"><h3 class="font-bold"><%= incident.title %></h3><span class="text-xs font-bold <%= incident.resolved_at?'text-emerald-700':'text-red-600' %>"><%= incident.resolved_at?'Opgelost':'Actief' %></span></div><p class="mt-2 text-sm text-[#686d6d]"><%= incident.cause %><% if(service){ %> · <%= service.name %><% } %></p><p class="mt-2 text-xs text-[#969999]"><%= new Date(incident.started_at).toLocaleString('nl-NL',{timeZone:status.site.timezone}) %><% if(incident.resolved_at){ %> – <%= new Date(incident.resolved_at).toLocaleString('nl-NL',{timeZone:status.site.timezone}) %><% } %></p></article>
          <% }) %>
        </div>
      <% } %>
    </section>
    <footer class="flex flex-wrap justify-between gap-3 border-t border-[#cfcac1] pt-5 text-xs text-[#777c7c]"><span>still curious. still monitoring.</span><span>Powered by coffee and scheduled requests.</span></footer>
  </main>
</body>
</html>

